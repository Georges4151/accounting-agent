# ========== 数据库配置 ==========
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accounting_db

# ========== JWT 配置 ==========
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080

# ========== API Key 加密密钥 ==========
KEY_ENCRYPTION_KEY=your-fernet-key-change-in-production

# ========== Ollama 配置 ==========
OLLAMA_BASE_URL=http://localhost:11434

# ========== 发票识别模型 ==========
# 为空时自动检测可用视觉模型，指定模型名则只使用该模型
# 推荐: qwen3-vl:4b (中文发票识别效果好)
INVOICE_VISION_MODEL=

# ========== CORS 配置 ==========
CORS_ORIGINS=["http://localhost:5173"]

# ========== 安全配置 ==========
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8